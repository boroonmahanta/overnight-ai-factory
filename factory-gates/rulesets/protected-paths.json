{
  "name": "protected-paths",
  "target": "push",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 0,
      "actor_type": "Team",
      "bypass_mode": "always"
    },
    {
      "actor_id": 0,
      "actor_type": "Team",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "repository_property": {
      "include": [
        {
          "name": "factory",
          "property_values": [
            "enabled"
          ],
          "source": "custom"
        }
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "file_path_restriction",
      "parameters": {
        "restricted_file_paths": [
          "tests/acceptance/**",
          "tests/scenarios/**",
          "specs/*/spec.md",
          "specs/*/checklists/**",
          "glossary.md",
          "docs/adr/**",
          "coding-standards.md",
          ".specify/**",
          ".github/**",
          "AGENTS.md",
          "CLAUDE.md",
          ".claude/**",
          ".mcp/**",
          "scripts/**",
          "builders/lib/**",
          "deploy/**"
        ]
      }
    }
  ]
}
