{
  "name": "factory-required-workflows",
  "target": "branch",
  "enforcement": "evaluate",
  "bypass_actors": [],
  "conditions": {
    "repository_property": {
      "include": [
        {
          "name": "factory",
          "property_values": [
            "enabled"
          ],
          "source": "custom"
        }
      ],
      "exclude": []
    },
    "ref_name": {
      "include": [
        "refs/heads/main",
        "refs/heads/integration"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "workflows",
      "parameters": {
        "do_not_enforce_on_create": false,
        "workflows": [
          {
            "path": ".github/workflows/lcp-gate.yml",
            "ref": "refs/heads/release",
            "repository_id": 0
          }
        ]
      }
    }
  ]
}
